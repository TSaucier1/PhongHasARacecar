{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"], "jsx": "preserve",
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"] }, "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "web/src/**/*.ts", "web/src/**/*.vue", "web/env.d.ts"]
}
